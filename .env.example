# Builda environment variables.
# Copy to .env.local (or run `npm run env:local`, which fills in the Supabase
# values for you). Never commit .env.local.

# --- Site -------------------------------------------------------------------
# Public URL of the app. Used to build magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Local values come from `npx supabase status`. In production, use the
# project's URL and keys from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon (publishable) key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key. Server only. Bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Super admin ------------------------------------------------------------
# Comma-separated emails that get super admin rights when they sign in.
SUPER_ADMIN_EMAILS=otumosesjobs@gmail.com

# --- AI (Anthropic) ---------------------------------------------------------
# Leave empty to use the mock AI provider (fixtures in lib/ai/fixtures/).
ANTHROPIC_API_KEY=
# Artificial delay for mock AI responses, in milliseconds.
AI_MOCK_DELAY_MS=600

# --- n8n --------------------------------------------------------------------
# Base URL for n8n webhooks, e.g. https://your-instance.app.n8n.cloud/webhook
# Leave empty to run n8n jobs locally through the AI provider.
N8N_WEBHOOK_BASE_URL=
# Shared secret sent in the x-builda-secret header on every webhook call.
# n8n should reject requests without it. Generate a long random string.
N8N_WEBHOOK_SECRET=
