# Builda environment variables.
# Copy to .env.local (or run `npm run env:local`, which fills in the Supabase
# values for you). Never commit .env.local.

# --- Site -------------------------------------------------------------------
# Public URL of the app. Used to build magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Local values come from `npx supabase status`. In production, use the
# project's URL and keys from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon (publishable) key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key. Server only. Bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Super admin ------------------------------------------------------------
# Comma-separated emails that get super admin rights when they sign in.
SUPER_ADMIN_EMAILS=otumosesjobs@gmail.com

# --- AI ---------------------------------------------------------------------
# The app uses Anthropic if ANTHROPIC_API_KEY is set, otherwise OpenAI if
# OPENAI_API_KEY is set, otherwise the mock provider (fixtures in
# lib/ai/fixtures/). Model names for each provider: lib/config/models.ts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# auto (default): Anthropic, then OpenAI, then mock. Or force one of
# anthropic | openai | mock. Use mock to click around without spending credit.
AI_PROVIDER=auto
# Artificial delay for mock AI responses, in milliseconds.
AI_MOCK_DELAY_MS=600

# --- n8n --------------------------------------------------------------------
# Base URL for n8n webhooks, e.g. https://your-instance.app.n8n.cloud/webhook
# Leave empty to run n8n jobs locally through the AI provider.
N8N_WEBHOOK_BASE_URL=
# Shared secret sent in the x-builda-secret header on every webhook call.
# n8n should reject requests without it. Generate a long random string.
N8N_WEBHOOK_SECRET=

# The no-sign-in demo ("Try the demo" on the home page). Each sandbox gets
# DEMO_AI_UNITS of live AI (about one unit per AI call), all sandboxes share
# DEMO_DAILY_AI_UNITS a day, and then the demo uses scripted replies.
DEMO_ENABLED=true
DEMO_AI_UNITS=40
DEMO_DAILY_AI_UNITS=600
DEMO_STARTS_PER_IP_PER_DAY=5
# Optional salt for hashing visitor IPs (only the hash is stored).
DEMO_IP_SALT=
# Quick discovery (the no-sign-in game on the home page). Each discovery gets
# DISCOVERY_AI_UNITS of live AI (a full game with follow-up questions uses
# about 8), all discoveries share DISCOVERY_DAILY_AI_UNITS a day, then replies
# are scripted. At most DISCOVERY_STARTS_PER_IP_PER_DAY new ones per IP.
DISCOVERY_AI_UNITS=20
DISCOVERY_DAILY_AI_UNITS=1500
DISCOVERY_STARTS_PER_IP_PER_DAY=15
