{
  "name": "automation-breakout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:seed",
    "db:types": "supabase gen types typescript --local > lib/db/types.tmp.ts && node -e \"require('fs').renameSync('lib/db/types.tmp.ts','lib/db/types.ts')\" || (rm -f lib/db/types.tmp.ts && exit 1)",
    "env:local": "tsx scripts/write-env.ts",
    "ai:try": "tsx --conditions=react-server scripts/try-ai.ts",
    "ai:blueprint": "tsx --conditions=react-server scripts/try-blueprint.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "preview": "next build && next start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "openai": "^7.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
